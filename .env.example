# Copy to .env, fill in, keep mode 600. Never commit the real file.
# Unguessable token (32+ random hex chars recommended). It appears in the
# endpoint path: /mcp-<token>/mcp — treat the full URL as a secret.
MUSE_MCP_TOKEN=
# Port on 127.0.0.1 (default 8903). Expose it through a tunnel/reverse
# proxy; do not bind the server directly to a public interface.
MUSE_MCP_PORT=8903
# Public hostname the endpoint is reached at (for Host-header allowlist).
MUSE_MCP_PUBLIC_HOST=muse.example.com
# Where queue/done/media data lives.
MUSE_MCP_DATA_DIR=/home/you/data/muse-mcp-bridge
# Household backend: module exposing DashboardService (see
# example_backend.py). The production value points at a private
# household dashboard package on the author's server.
MUSE_MCP_BACKEND_MODULE=example_backend
# Extra sys.path entry for the backend module's package, if needed.
MUSE_MCP_BACKEND_PATH=
# Acting user key passed to the backend.
MUSE_MCP_USER_KEY=owner
# Home Assistant helper (REST client holding the HA token).
HA_API_BIN=/home/you/bin/ha-api
